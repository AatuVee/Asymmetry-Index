//@version=6
// =============================================================================
// Sensitivity & Upside Index
// =============================================================================
// Measures how reactively an asset moves — both to the downside (SI) and to
// the upside (UI).  A "streak" is a run of consecutive down (or up) days that
// produces a total move ≥ threshold.  Only streaks above the median size are
// counted as significant (noise filter).  Shorter streaks are up-weighted
// (speed weighting).  A Bayesian shrinkage factor dampens small samples.
//
// SI  – Sensitivity Index  : weighted intensity of downside streaks
// UI  – Upside Index       : weighted intensity of upside streaks
// Reactivity               : (SI + UI) / 2  — overall two-sided reactivity
// Asymmetry                : UI / SI  — >1.2 upside-biased, <0.8 downside-biased
//
// Thresholds are calibrated relative to RSP (S&P 500 Equal Weight) Reactivity
// (~9.2 on a 252-bar lookback).  You can update the benchmark input if needed.
//
// Designed for the Daily (1D) timeframe. Results on intraday charts are not meaningful.
// Works on any asset with daily price data (stocks, ETFs, crypto, forex).
// Note: the RSP benchmark (default 9.2) is calibrated for equities — for crypto or other
// high-volatility assets, consider increasing the benchmark input to match the asset class.
// =============================================================================
indicator("Asymmetry Index", shorttitle="AI", overlay=false, max_bars_back=500)

// ─── Inputs ───────────────────────────────────────────────────────────────────
threshold  = input.float(2.0,  "Streak threshold (%)",   minval=0.1, step=0.1,
             tooltip="Minimum total move for a streak to be recorded (default 2 %).") / 100
lookback   = input.int(252,    "Lookback (bars)",         minval=20,
             tooltip="Number of bars to look back. 252 ≈ 1 trading year.")
show_ui    = input.bool(true,  "Show Upside Index (UI)")
show_re    = input.bool(true,  "Show Reactivity")
rsp_re     = input.float(9.2,  "RSP Reactivity benchmark",
             tooltip="Historical Reactivity of RSP (S&P 500 Equal Weight ETF) over 252 bars. Default ≈ 9.2. Update periodically if needed.")

// ─── Streak arrays (symbol) ───────────────────────────────────────────────────
var array<float> si_mag = array.new_float()
var array<int>   si_len = array.new_int()
var array<int>   si_bar = array.new_int()
var array<float> ui_mag = array.new_float()
var array<int>   ui_len = array.new_int()
var array<int>   ui_bar = array.new_int()
var float dn_open = na
var int   dn_len  = 0
var float up_open = na
var int   up_len  = 0

// ─── Streak tracking ──────────────────────────────────────────────────────────
ret = (close - close[1]) / close[1]
if ret < 0
    if na(dn_open)
        dn_open := close[1]
        dn_len  := 0
    dn_len += 1
    if not na(up_open)
        mag = (close[1] - up_open) / up_open
        if mag >= threshold
            array.push(ui_mag, mag)
            array.push(ui_len, up_len)
            array.push(ui_bar, bar_index)
        up_open := na
        up_len  := 0
else
    if not na(dn_open)
        mag = (dn_open - close[1]) / dn_open
        if mag >= threshold
            array.push(si_mag, mag)
            array.push(si_len, dn_len)
            array.push(si_bar, bar_index)
        dn_open := na
        dn_len  := 0
    if na(up_open)
        up_open := close[1]
        up_len  := 0
    up_len += 1

// ─── Purge streaks outside the lookback window ────────────────────────────────
if array.size(si_bar) > 0
    while array.size(si_bar) > 0 and (bar_index - array.get(si_bar, 0)) > lookback
        array.shift(si_mag)
        array.shift(si_len)
        array.shift(si_bar)
if array.size(ui_bar) > 0
    while array.size(ui_bar) > 0 and (bar_index - array.get(ui_bar, 0)) > lookback
        array.shift(ui_mag)
        array.shift(ui_len)
        array.shift(ui_bar)

// ─── Index calculation ────────────────────────────────────────────────────────
// Steps: median noise filter → speed weights (1/streak_days) → annualize → shrinkage
calc_index(mags, lens, lb) =>
    result = float(na)
    n = array.size(mags)
    if n >= 2
        med = array.median(mags)
        weights = array.new_float()
        for i = 0 to n - 1
            if array.get(mags, i) > med
                array.push(weights, 1.0 / math.max(array.get(lens, i), 1))
        nw = array.size(weights)
        if nw > 0
            mean_w = array.avg(weights)
            sum_w  = 0.0
            for i = 0 to nw - 1
                sum_w += array.get(weights, i) / mean_w
            raw       = med * sum_w * 100
            annualize = 252.0 / lb
            shrinkage = nw / (nw + 3.0)
            result   := raw * annualize * shrinkage
    result

// ─── Compute values ───────────────────────────────────────────────────────────
si_val = calc_index(si_mag, si_len, lookback)
ui_val = calc_index(ui_mag, ui_len, lookback)
re_val = not na(si_val) and not na(ui_val) ? (si_val + ui_val) / 2 : float(na)
asym   = not na(si_val) and not na(ui_val) and si_val != 0 ? ui_val / si_val : float(na)

// ─── Rating vs RSP benchmark ──────────────────────────────────────────────────
// Low < 3× RSP ≤ Average < 6× RSP ≤ High < 12× RSP ≤ Extreme
get_rating(val, bench) =>
    na(val) or na(bench) or bench == 0 ? "N/A" :
     val / bench < 3.0  ? "Low" :
     val / bench < 6.0  ? "Average" :
     val / bench < 12.0 ? "High" : "Extreme"

// ─── Plots ───────────────────────────────────────────────────────────────────
p_si = plot(si_val,                "SI (Sensitivity)", color=color.red,   linewidth=2)
p_ui = plot(show_ui ? ui_val : na, "UI (Upside)",      color=color.green, linewidth=2)

// Fill between SI and UI: green when upside dominates, red when downside dominates
fill_color = not na(si_val) and not na(ui_val) ?
     ui_val > si_val ? color.new(color.green, 75) :
     color.new(color.red, 75) : na
fill(p_si, p_ui, color=fill_color, title="SI/UI Asymmetry fill")

// Reactivity on top (most prominent)
plot(show_re ? re_val : na, "Reactivity", color=color.new(color.blue, 20), linewidth=3)

// Asymmetry ratio (UI/SI) — note: uses a different scale (0–3 range)
plot(not na(asym) ? asym : na, "Asymmetry (UI/SI)", color=color.new(color.white, 40), linewidth=1, style=plot.style_line, display=display.all)

// ─── Threshold zones ──────────────────────────────────────────────────────────
h0   = hline(0,   color=color.new(color.gray,   50), linestyle=hline.style_dotted)
h27  = hline(27,  color=color.new(color.yellow, 40), linestyle=hline.style_dashed, linewidth=1, title="Average (3× RSP)")
h55  = hline(55,  color=color.new(color.orange, 40), linestyle=hline.style_dashed, linewidth=1, title="High (6× RSP)")
h110 = hline(110, color=color.new(color.red,    40), linestyle=hline.style_dashed, linewidth=1, title="Extreme (12× RSP)")
h300 = hline(300, color=color.new(color.red,     0), linestyle=hline.style_dotted, linewidth=1)

fill(h0,   h27,  color=color.new(color.green,  90), title="Low zone")
fill(h27,  h55,  color=color.new(color.yellow, 90), title="Average zone")
fill(h55,  h110, color=color.new(color.orange, 90), title="High zone")
fill(h110, h300, color=color.new(color.red,    90), title="Extreme zone")

// ─── Info label ───────────────────────────────────────────────────────────────
asym_str   = na(asym) ? "N/A" : asym > 1.2 ? "▲ Upside-biased" : asym < 0.8 ? "▼ Downside-biased" : "● Symmetric"
asym_color = na(asym) ? color.gray : asym > 1.2 ? color.green : asym < 0.8 ? color.red : color.orange

lbl_text = "Reactivity: "  + get_rating(re_val, rsp_re) +
         "\nAsymmetry: "   + str.tostring(math.round(nz(asym), 2)) + "  " + asym_str +
         "\nRSP bench: "   + str.tostring(math.round(nz(rsp_re), 1))

var label lbl = na
label.delete(lbl)
lbl := label.new(bar_index, math.max(nz(si_val), nz(ui_val), nz(re_val)) * 1.05,
     lbl_text, style=label.style_label_left,
     color=color.new(asym_color, 80), textcolor=asym_color, size=size.small)
